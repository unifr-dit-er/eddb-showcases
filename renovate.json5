// Dependency updates of the monorepo (decision of 27.10.2026,
// eddb/ops/decisions/2026-10-27-ci-et-renovate.md in Almanac).
// - Development tools and GitHub Actions: weekly, merged automatically
//   once CI passes; they change nothing in production.
// - What runs in production (dependencies, Node image, lockfile): one
//   batch a month, merged by hand, then the showcases are redeployed.
// - Security fixes: at once, labelled "security".
{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: ['config:recommended', ':semanticCommits', 'docker:pinDigests', 'helpers:pinGitHubActionDigests'],
  timezone: 'Europe/Zurich',
  schedule: ['before 6am on monday'],
  labels: ['dependencies'],
  // A release must be a week old: a compromised version is usually
  // withdrawn within days.
  minimumReleaseAge: '7 days',
  // Merged by Renovate itself after a green CI: main is not protected.
  automergeType: 'pr',
  platformAutomerge: false,
  osvVulnerabilityAlerts: true,
  vulnerabilityAlerts: {
    labels: ['security'],
    schedule: ['at any time'],
    minimumReleaseAge: null,
  },
  lockFileMaintenance: {
    enabled: true,
    schedule: ['before 6am on the first day of the month'],
    labels: ['dependencies', 'production'],
  },
  packageRules: [
    {
      description: 'Development tools, minor and patch: weekly, automerged',
      matchDepTypes: ['devDependencies'],
      matchUpdateTypes: ['minor', 'patch'],
      groupName: 'development tools',
      automerge: true,
    },
    {
      description: 'GitHub Actions, except majors: weekly, automerged',
      matchManagers: ['github-actions'],
      matchUpdateTypes: ['minor', 'patch', 'digest', 'pin', 'pinDigest'],
      groupName: 'GitHub Actions',
      automerge: true,
    },
    {
      description: 'What runs in production, minor and patch: one batch a month, merged by hand',
      matchDepTypes: ['dependencies'],
      matchUpdateTypes: ['minor', 'patch'],
      groupName: 'production dependencies',
      schedule: ['before 6am on the first day of the month'],
      labels: ['dependencies', 'production'],
    },
    {
      description: 'Packages that must follow their production counterpart (Next.js, React)',
      matchPackageNames: ['eslint-config-next', '@next/*', '@types/react', '@types/react-dom'],
      matchUpdateTypes: ['minor', 'patch'],
      groupName: 'production dependencies',
      schedule: ['before 6am on the first day of the month'],
      labels: ['dependencies', 'production'],
      automerge: false,
    },
    {
      description: 'Node image of the Dockerfiles: in the monthly production batch',
      matchManagers: ['dockerfile'],
      groupName: 'production dependencies',
      schedule: ['before 6am on the first day of the month'],
      labels: ['dependencies', 'production'],
    },
    {
      // The node-version of the CI is matched by its dependency name only.
      description: 'Node stays on 22 (image, CI, types) until we decide to move',
      matchDepNames: ['node', '@types/node'],
      allowedVersions: '<23',
    },
    {
      description: 'Majors: one pull request each, monthly, merged by hand',
      matchUpdateTypes: ['major'],
      schedule: ['before 6am on the first day of the month'],
      automerge: false,
    },
  ],
}
